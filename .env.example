# Copy this file to .env and fill in your values.
# .env is git-ignored; never commit secrets.

# Required: Postgres connection string
DATABASE_URL=postgres://fairway:fairway@localhost:5432/fairway?sslmode=disable

# Optional: Horizon node (defaults to public mainnet)
HORIZON_URL=https://horizon.stellar.org

# Fallback USD-equivalent trade size when a corridor has no target_usd_value.
SELL_AMOUNT=100

# Optional: How often to run measurements (Go duration string, default: 5m)
MEASURE_INTERVAL=5m

# Optional: Loss % thresholds for integrity state transitions against mid-market benchmark
# < 2.5% = usable, 2.5% to 5.0% = degraded, >= 5.0% = unusable
DEGRADED_LOSS_PCT=2.5
UNUSABLE_LOSS_PCT=5.0

# Optional: Reference rate provider endpoint (defaults to Frankfurter v2 rates)
REFERENCE_RATE_URL=https://api.frankfurter.dev/v2/rates

# Optional: Plain HTTP POST webhook URL. Leave empty to disable.
WEBHOOK_URL=

# Optional: Webhook payload format: "raw" (Fairway's native JSON, default) or
# "discord" (Discord embed message, for posting to a Discord channel webhook URL).
WEBHOOK_FORMAT=raw

# Optional: Corridors config file (default: corridors.yaml)
CORRIDORS_FILE=corridors.yaml

# Optional: HTTP listen address (default: :8080)
LISTEN_ADDR=:8080

# Optional: Allowed CORS origins, comma-separated (e.g. https://gofairway.github.io). Leave empty to disable CORS.
CORS_ALLOWED_ORIGINS=

# Optional: Enable in-memory per-client rate limiting (default: true)
RATE_LIMIT_ENABLED=true

# Optional: Rate limit refill rate in requests per second per client IP (default: 10.0)
RATE_LIMIT_RPS=10.0

# Optional: Rate limit burst token capacity per client IP (default: 30)
RATE_LIMIT_BURST=30

# Optional: Trust X-Forwarded-For header for client IP behind a reverse proxy (default: false).
# Caution: Leave false when directly exposed to the public internet to prevent header spoofing.
TRUST_PROXY=false
